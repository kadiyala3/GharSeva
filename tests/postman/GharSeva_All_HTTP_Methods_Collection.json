              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"addressLine\": \"Flat 704, Royal Palms\",\n  \"area\": \"Gomti Nagar\",\n  \"city\": \"Lucknow\",\n  \"state\": \"Uttar Pradesh\",\n  \"pincode\": \"226010\"\n}"
            }
