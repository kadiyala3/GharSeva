    {
      "name": "2. POST Method Tests",
      "item": [
        {
          "name": "[POST] Admin Authentication & Token Generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gharseva.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "var res = pm.response.json();",
                  "pm.test('POST login generated JWT token', () => {",
                  "    pm.expect(res.data.token).to.be.a('string');",
                  "    pm.expect(res.data.role).to.eql('ADMIN');",
                  "});",
                  "pm.collectionVariables.set('adminToken', res.data.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[POST] Customer Authentication & Token Generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
